# Copiar este archivo como ".env" antes de levantar el proyecto:
#   cp .env.example .env      (Windows PowerShell: Copy-Item .env.example .env)
# El archivo .env NO se sube a git.

# --- Base de datos ---
POSTGRES_DB=patopan
POSTGRES_USER=patopan
POSTGRES_PASSWORD=cambiar_esta_clave
DB_PORT=5432

# --- API ---
# Generar uno propio, por ejemplo:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar_este_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=12h
# true = al iniciar la API carga usuarios iniciales, repartidores y clientes del cuaderno (es idempotente)
SEED_ON_START=true

# --- Web ---
# El sistema quedará en http://localhost:8080
WEB_PORT=8080
