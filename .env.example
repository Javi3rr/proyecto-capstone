# Copiar este archivo como ".env" antes de levantar el proyecto:
#   cp .env.example .env      (Windows PowerShell: Copy-Item .env.example .env)
# El archivo .env NO se sube a git.

# --- Base de datos ---
POSTGRES_DB=patopan
POSTGRES_USER=patopan
POSTGRES_PASSWORD=cambiar_esta_clave
DB_PORT=5432

# --- API ---
# Generar uno propio, por ejemplo:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar_este_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=12h
# true = al iniciar la API carga usuarios iniciales, repartidores y clientes del cuaderno (es idempotente)
SEED_ON_START=true

# --- Guía de despacho electrónica (SII) ---
# simulado   = sin conexión; asigna folios de prueba (demos y clases)
# pruebas    = ambiente de desarrollo de OpenFactura, con datos públicos de prueba (sin efecto tributario)
# produccion = emisión real ante el SII: requiere contrato con el proveedor, certificado digital y folios de la panadería
DTE_MODO=simulado
# Solo para produccion (en pruebas se usan los datos de prueba del proveedor):
DTE_API_KEY=
DTE_EMISOR_RUT=
DTE_EMISOR_RAZON_SOCIAL=
DTE_EMISOR_GIRO=
DTE_EMISOR_ACTECO=
DTE_EMISOR_DIRECCION=
DTE_EMISOR_COMUNA=
DTE_EMISOR_SUCURSAL=
# true = el precio del kg incluye IVA (la guía desglosa neto e IVA)
DTE_PRECIOS_CON_IVA=true

# --- Web ---
# El sistema quedará en http://localhost:8080
WEB_PORT=8080
